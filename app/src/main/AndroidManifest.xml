<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.project.wattchat"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk
        android:minSdkVersion="11"
        android:targetSdkVersion="17" />
<uses-permission android:name="android.permission.READ_PHONE_STATE" />
<uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WATTCHAT">
        <activity android:name="com.project.wattchat.MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.project.wattchat.SignUpActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SIGNUP" />
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:name="com.project.wattchat.MessageList"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MESSAGELIST" />
                <category android:name="android.intent.category.DEFAULT " />
            </intent-filter>
        </activity>
        <activity android:name="com.project.wattchat.UpdateUserInfo" android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.UPDATEUSERINFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.project.wattchat.TelephoneGuide" android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.TELEPHONEGUIDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.project.wattchat.Conversation" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.CONVERSATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".SMSReceiver">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>